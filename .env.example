# Unisphere Environment Configuration Example
# Copy this file to .env and configure with your credentials

# Port to serve the full-stack app (default: 3000)
PORT=3000

# MongoDB Connection String (Atlas URI or local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/unisphere?retryWrites=true&w=majority
# If omitted or left empty, the application runs with an in-memory fallback store
MONGODB_URI=

# JWT Secret for authenticating student sessions
JWT_SECRET=your_super_secret_jwt_key_here

# Optional: Google Gemini API Key for campus AI capabilities
GEMINI_API_KEY=
